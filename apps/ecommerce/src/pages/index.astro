<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Tasty Bites & Hamburger Rapid - Food Made with Love. Fast food gourmet, hamburguesas de autor, pizzas artesanales y delivery rápido." />
  
  <!-- Google Fonts: Plus Jakarta Sans for modern typography + Caveat for handwritten script / doodles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    :root {
      /* Brand Color Palette Replicating the Attached Design */
      --primary: #F5A623;          /* Warm Golden Yellow / Amber */
      --primary-hover: #E09612;    /* Darker Amber */
      --primary-subtle: #FFF8EB;   /* Warm light tint */
      --primary-dark: #B87309;     /* Deep gold for badges */
      
      --accent-red: #E53935;       /* "Popular" Badge Red */
      --accent-red-hover: #C62828;
      
      --dark-bg: #141210;          /* Deep warm charcoal/black for Hero & Dark sections */
      --dark-surface: #1E1A17;     /* Dark card/banner background */
      --dark-border: rgba(255, 255, 255, 0.1);
      
      --cream-bg: #FAF8F5;         /* Warm cream canvas for menu & light sections */
      --cream-surface: #FFFFFF;    /* Pure white product cards */
      --cream-subtle: #F3EFEA;     /* Soft warm grey/beige for containers */
      --cream-border: #E8E3DC;     /* Elegant soft border */
      
      --text-dark: #191614;        /* Headings on light background */
      --text-muted: #6B655F;       /* Secondary text on light background */
      --text-light: #FFFFFF;       /* Headings on dark background */
      --text-light-muted: #C7C2BA; /* Secondary text on dark background */
      
      --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-hand: 'Caveat', cursive, sans-serif;
      
      --shadow-card: 0 10px 30px -5px rgba(25, 22, 20, 0.07), 0 4px 12px -2px rgba(25, 22, 20, 0.04);
      --shadow-hover: 0 20px 40px -8px rgba(245, 166, 35, 0.22), 0 8px 16px -2px rgba(25, 22, 20, 0.08);
      --shadow-gold: 0 8px 24px rgba(245, 166, 35, 0.35);
      
      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 26px;
      --radius-pill: 9999px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--cream-bg);
      color: var(--text-dark);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      font-family: inherit;
      border: none;
      cursor: pointer;
    }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ==========================================================================
       1. HEADER / NAVIGATION (Dark Glassmorphic over Hero)
       ========================================================================== */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(20, 18, 16, 0.88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.3s ease;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 80px;
    }

    /* Brand Logo replicating "Tasty Bites" with chef hat icon */
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      color: var(--text-light);
    }

    .brand-logo-icon {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      filter: drop-shadow(0 2px 8px rgba(245, 166, 35, 0.4));
    }

    .brand-logo-text {
      display: flex;
      flex-direction: column;
    }

    .brand-logo-name {
      font-family: var(--font-main);
      font-weight: 800;
      font-size: 1.45rem;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #FFFFFF;
    }

    .brand-logo-name span {
      color: var(--primary);
    }

    .brand-logo-sub {
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-light-muted);
      font-weight: 600;
    }

    /* Nav Links */
    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
      list-style: none;
    }

    .nav-links a {
      color: #E6E1DA;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s ease;
      position: relative;
      padding: 0.3rem 0;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #FFFFFF;
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2.5px;
      background: var(--primary);
      border-radius: 9999px;
    }

    /* Nav Actions */
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .icon-btn {
      background: transparent;
      color: #FFFFFF;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
    }

    .icon-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--primary);
    }

    .cart-badge {
      position: absolute;
      top: 2px;
      right: 2px;
      background: var(--primary);
      color: #141210;
      font-size: 0.72rem;
      font-weight: 800;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      transition: transform 0.2s ease;
    }

    /* Primary CTA Buttons */
    .btn-gold {
      background: var(--primary);
      color: #1A1305;
      font-weight: 700;
      font-size: 0.92rem;
      padding: 0.65rem 1.45rem;
      border-radius: var(--radius-pill);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: var(--shadow-gold);
    }

    .btn-gold:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(245, 166, 35, 0.45);
    }

    .btn-gold-sm {
      padding: 0.5rem 1.15rem;
      font-size: 0.84rem;
    }

    .btn-outline {
      background: transparent;
      color: var(--text-dark);
      border: 1.5px solid var(--text-dark);
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.5rem 1.25rem;
      border-radius: var(--radius-pill);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }

    .btn-outline:hover {
      background: var(--text-dark);
      color: #FFFFFF;
      transform: translateY(-1px);
    }

    /* ==========================================================================
       2. HERO SECTION (Dark ambiance with prominent Burger & fries)
       ========================================================================== */
    .hero-section {
      background: #141210 radial-gradient(circle at 75% 40%, rgba(245, 166, 35, 0.16) 0%, rgba(20, 18, 16, 0.95) 70%);
      color: var(--text-light);
      position: relative;
      padding: 4.5rem 0 5.5rem;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .hero-tag {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.25em;
      color: #D6D0C5;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .hero-tag span {
      color: var(--primary);
    }

    .hero-title {
      font-size: 4.2rem;
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: #FFFFFF;
      margin-bottom: 1.4rem;
    }

    .hero-title .script-love {
      font-family: var(--font-hand);
      font-weight: 700;
      color: var(--primary);
      font-size: 5.6rem;
      line-height: 0.8;
      display: inline-block;
      margin-left: 0.25rem;
      position: relative;
    }

    .hero-title .script-love .doodle-heart {
      display: inline-block;
      font-size: 2.2rem;
      transform: rotate(12deg) translateY(-8px);
      margin-left: 0.3rem;
      color: var(--primary);
    }

    .hero-desc {
      font-size: 1.12rem;
      color: var(--text-light-muted);
      line-height: 1.65;
      max-width: 480px;
      margin-bottom: 2.25rem;
    }

    .hero-cta-wrap {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 3.25rem;
    }

    /* 3 Hero Feature Badges */
    .hero-features {
      display: flex;
      gap: 2.25rem;
      align-items: center;
      padding-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .hero-feature-item {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .hero-feature-icon {
      color: var(--primary);
      font-size: 1.4rem;
      display: flex;
      align-items: center;
    }

    .hero-feature-text {
      font-size: 0.82rem;
      font-weight: 700;
      color: #E2DDD5;
      line-height: 1.2;
    }

    /* Hero Right Visual Column */
    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-image-container {
      position: relative;
      width: 100%;
      max-width: 540px;
      filter: drop-shadow(0 25px 45px rgba(0, 0, 0, 0.65));
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-image-container:hover {
      transform: scale(1.02);
    }

    .hero-main-img {
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 28px;
      display: block;
    }

    /* Doodle Annotation: "Best Burger in Town" */
    .hero-doodle {
      position: absolute;
      top: -24px;
      right: 15px;
      color: var(--primary);
      font-family: var(--font-hand);
      font-size: 1.85rem;
      font-weight: 700;
      line-height: 1.1;
      text-align: center;
      pointer-events: none;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
      transform: rotate(6deg);
    }

    .hero-doodle .sparks {
      font-size: 1.3rem;
      letter-spacing: 0.15em;
      display: block;
      margin-bottom: -4px;
    }

    .hero-doodle .arrow {
      font-size: 2rem;
      display: block;
      transform: rotate(50deg) translateX(-10px);
    }

    /* ==========================================================================
       3. CATEGORY CAROUSEL / "Something for Every Craving"
       ========================================================================== */
    .craving-section {
      padding: 5rem 0 4rem;
      background: var(--cream-bg);
    }

    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2.5rem;
    }

    .section-label {
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent-red);
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-title {
      font-size: 2.35rem;
      font-weight: 900;
      letter-spacing: -0.025em;
      color: var(--text-dark);
      line-height: 1.15;
    }

    .view-all-link {
      color: var(--text-dark);
      font-weight: 700;
      font-size: 0.95rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.2s, transform 0.2s;
    }

    .view-all-link:hover {
      color: var(--primary-dark);
      transform: translateX(3px);
    }

    /* Category Cards Grid */
    .craving-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 1.25rem;
      overflow-x: auto;
      padding-bottom: 1rem;
      scrollbar-width: thin;
    }

    .craving-card {
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      text-align: center;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      outline: none;
    }

    .craving-card:hover {
      transform: translateY(-5px);
    }

    .craving-card.active .craving-img-circle {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.25);
    }

    .craving-img-circle {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid #FFFFFF;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      transition: all 0.3s ease;
      background: #FFFFFF;
    }

    .craving-card:hover .craving-img-circle {
      box-shadow: 0 10px 22px rgba(245, 166, 35, 0.25);
    }

    .craving-img-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .craving-card:hover .craving-img-circle img {
      transform: scale(1.1);
    }

    .craving-name {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-dark);
    }

    /* ==========================================================================
       4. OUR SPECIALS / "Popular Menu"
       ========================================================================== */
    .specials-section {
      padding: 2rem 0 5rem;
      background: var(--cream-bg);
    }

    .specials-label-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.35rem;
    }

    .specials-label {
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .specials-dash {
      width: 32px;
      height: 3px;
      background: var(--primary);
      border-radius: 9999px;
    }

    .specials-subtitle {
      color: var(--text-muted);
      font-size: 1rem;
      margin-top: 0.4rem;
      max-width: 580px;
    }

    /* Product Cards 4-Column Grid */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
      margin-top: 2.5rem;
    }

    .product-card {
      background: var(--cream-surface);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-card);
      border: 1px solid var(--cream-border);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
      position: relative;
    }

    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }

    .product-img-wrap {
      position: relative;
      aspect-ratio: 4/3;
      overflow: hidden;
      background: #F4EFEA;
    }

    .product-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s ease;
    }

    .product-card:hover .product-img-wrap img {
      transform: scale(1.06);
    }

    .card-badge-pill {
      position: absolute;
      top: 14px;
      left: 14px;
      background: var(--accent-red);
      color: #FFFFFF;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-pill);
      letter-spacing: 0.02em;
      box-shadow: 0 4px 10px rgba(229, 57, 53, 0.3);
      z-index: 2;
    }

    .card-badge-gold {
      background: #D97706;
      color: #FFFFFF;
      box-shadow: 0 4px 10px rgba(217, 119, 6, 0.3);
    }

    .card-content {
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .product-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 0.45rem;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .product-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin-bottom: 1.25rem;
      flex-grow: 1;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-footer {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      margin-top: auto;
    }

    .product-price-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .product-price {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-dark);
      letter-spacing: -0.02em;
    }

    .product-price small {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-left: 0.35rem;
    }

    .product-rating {
      font-size: 0.82rem;
      font-weight: 700;
      color: #D97706;
    }

    .btn-add-cart {
      background: var(--primary);
      color: #1A1305;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 0.65rem 1rem;
      border-radius: var(--radius-pill);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      transition: all 0.2s ease;
      width: 100%;
      box-shadow: 0 4px 12px rgba(245, 166, 35, 0.25);
    }

    .btn-add-cart:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(245, 166, 35, 0.35);
    }

    .btn-card-details {
      background: transparent;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      text-align: center;
      padding: 0.2rem;
      cursor: pointer;
      transition: color 0.2s;
    }

    .btn-card-details:hover {
      color: var(--primary-dark);
      text-decoration: underline;
    }

    /* Tab Filter for full 10 Author Burgers */
    .catalog-tabs-wrap {
      margin-top: 3.5rem;
      border-top: 1px solid var(--cream-border);
      padding-top: 3.5rem;
    }

    .catalog-filter-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .catalog-filter-btn {
      background: var(--cream-surface);
      border: 1px solid var(--cream-border);
      padding: 0.55rem 1.25rem;
      border-radius: var(--radius-pill);
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--text-muted);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .catalog-filter-btn:hover {
      border-color: var(--primary);
      color: var(--text-dark);
    }

    .catalog-filter-btn.active {
      background: var(--text-dark);
      color: #FFFFFF;
      border-color: var(--text-dark);
    }

    /* ==========================================================================
       5. SPLIT PROMO BANNERS ("COMBO IT BETTER" & "SWEET ENDINGS")
       ========================================================================== */
    .promo-banners-section {
      padding: 2rem 0 5rem;
      background: var(--cream-bg);
    }

    .promo-banners-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
    }

    /* Left Banner: Combo it Better (Dark Theme) */
    .promo-banner-dark {
      background: #141210;
      border-radius: var(--radius-lg);
      padding: 2.75rem 2.5rem;
      position: relative;
      overflow: hidden;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #FFFFFF;
      box-shadow: 0 15px 35px rgba(20, 18, 16, 0.2);
    }

    .promo-banner-dark::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(245, 166, 35, 0.15) 0%, transparent 70%);
      pointer-events: none;
    }

    .banner-text-col {
      max-width: 55%;
      z-index: 2;
    }

    .banner-title-dark {
      font-size: 2.4rem;
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      margin-bottom: 0.8rem;
    }

    .banner-title-dark span {
      color: var(--primary);
      display: block;
    }

    .banner-desc-dark {
      font-size: 0.95rem;
      color: #D6D0C5;
      margin-bottom: 1.6rem;
      line-height: 1.45;
      font-weight: 500;
    }

    .banner-img-col {
      width: 42%;
      position: relative;
      z-index: 2;
    }

    .banner-img-col img {
      width: 100%;
      height: auto;
      border-radius: 16px;
      display: block;
      filter: drop-shadow(0 15px 25px rgba(0,0,0,0.5));
      transition: transform 0.4s ease;
    }

    .promo-banner-dark:hover .banner-img-col img {
      transform: scale(1.04) rotate(-1deg);
    }

    /* Right Banner: Sweet Endings (Light/Cream Theme) */
    .promo-banner-light {
      background: #F4EFEA;
      border-radius: var(--radius-lg);
      padding: 2.75rem 2.5rem;
      position: relative;
      overflow: hidden;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-dark);
      border: 1px solid var(--cream-border);
      box-shadow: var(--shadow-card);
    }

    .banner-title-light {
      font-size: 2.4rem;
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      margin-bottom: 0.8rem;
    }

    .banner-desc-light {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 1.6rem;
      line-height: 1.45;
      font-weight: 500;
    }

    /* Doodle for Sweet Endings */
    .doodle-sweet {
      position: absolute;
      top: 18px;
      right: 25px;
      font-family: var(--font-hand);
      font-size: 1.45rem;
      font-weight: 700;
      color: #141210;
      line-height: 1.1;
      text-align: right;
      z-index: 3;
      transform: rotate(4deg);
    }

    .doodle-sweet .arrow-curve {
      display: block;
      font-size: 1.6rem;
      margin-top: -4px;
      transform: rotate(80deg) scaleX(-1);
    }

    .promo-banner-light:hover .banner-img-col img {
      transform: scale(1.04) rotate(1deg);
    }

    /* ==========================================================================
       6. VALUE PROPOSITION / TRUST BAR (4 PILLARS)
       ========================================================================== */
    .trust-pillars-section {
      padding: 2rem 0;
      background: var(--cream-bg);
      border-top: 1px solid var(--cream-border);
      border-bottom: 1px solid var(--cream-border);
    }

    .trust-pillars-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    .trust-pillar-item {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      padding: 1rem 1.25rem;
    }

    .trust-pillar-item:not(:last-child) {
      border-right: 1px solid var(--cream-border);
    }

    .pillar-icon-box {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
      flex-shrink: 0;
    }

    .pillar-text h4 {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-dark);
      line-height: 1.2;
    }

    .pillar-text p {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    /* ==========================================================================
       7. BOTTOM HERO / ORDER BANNER ("Crave It? We'll Deliver It!")
       ========================================================================== */
    .bottom-cta-section {
      padding: 4.5rem 0 5rem;
      background: var(--cream-bg);
    }

    .bottom-cta-banner {
      background: #141210 url('https://images.unsplash.com/photo-1513104890138-7c749659a591?w=1400&auto=format&fit=crop&q=80') center/cover no-repeat;
      border-radius: var(--radius-lg);
      overflow: hidden;
      position: relative;
      box-shadow: 0 25px 50px rgba(20, 18, 16, 0.35);
    }

    .bottom-cta-overlay {
      background: linear-gradient(90deg, #141210 0%, rgba(20, 18, 16, 0.92) 48%, rgba(20, 18, 16, 0.4) 100%);
      padding: 4.5rem 3.75rem;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 2.5rem;
    }

    .bottom-cta-tag {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #E2DDD5;
      margin-bottom: 0.75rem;
    }

    .bottom-cta-headline {
      font-size: 3.6rem;
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.025em;
      color: #FFFFFF;
      margin-bottom: 1.25rem;
    }

    .bottom-cta-headline .script-crave {
      font-family: var(--font-hand);
      color: var(--primary);
      font-size: 4.5rem;
      display: block;
      line-height: 0.9;
    }

    .bottom-cta-desc {
      font-size: 1.05rem;
      color: var(--text-light-muted);
      line-height: 1.55;
      max-width: 480px;
      margin-bottom: 2rem;
    }

    .bottom-cta-visual {
      position: relative;
      display: flex;
      justify-content: flex-end;
    }

    .doodle-vibes {
      position: absolute;
      top: -20px;
      right: 20px;
      font-family: var(--font-hand);
      color: #FFFFFF;
      font-size: 1.9rem;
      font-weight: 700;
      line-height: 1.1;
      text-align: right;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
      transform: rotate(8deg);
      z-index: 5;
    }

    .doodle-vibes span {
      color: var(--primary);
    }

    .doodle-vibes .vibe-sparks {
      font-size: 1.3rem;
      display: block;
    }

    /* ==========================================================================
       8. FOOTER & TRUST BAR
       ========================================================================== */
    footer {
      background: #FAF8F5;
      border-top: 1px solid var(--cream-border);
      padding: 3rem 0 2rem;
    }

    .footer-guarantees {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--cream-border);
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .guarantee-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-dark);
    }

    .guarantee-icon {
      color: var(--primary-dark);
      font-size: 1.2rem;
    }

    .footer-bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 2rem;
      font-size: 0.88rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .social-links {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .social-icon-btn {
      color: var(--text-dark);
      font-size: 1.15rem;
      transition: color 0.2s, transform 0.2s;
    }

    .social-icon-btn:hover {
      color: var(--primary-dark);
      transform: translateY(-2px);
    }

    .ecosystem-links {
      display: flex;
      gap: 1.25rem;
      font-weight: 600;
      align-items: center;
    }

    .ecosystem-links a {
      color: var(--text-muted);
      transition: color 0.2s;
    }

    .ecosystem-links a:hover {
      color: var(--text-dark);
    }

    /* ==========================================================================
       9. INTERACTIVE CART DRAWER (Slide-in)
       ========================================================================== */
    .cart-drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(4px);
      z-index: 2000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .cart-drawer-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: 440px;
      background: #FFFFFF;
      box-shadow: -10px 0 30px rgba(0,0,0,0.15);
      z-index: 2001;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .cart-drawer.active {
      transform: translateX(0);
    }

    .cart-drawer-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--cream-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cart-drawer-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .cart-close-btn {
      background: #F3EFEA;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      cursor: pointer;
      color: var(--text-dark);
      transition: background 0.2s;
    }

    .cart-close-btn:hover {
      background: #E8E3DC;
    }

    .cart-items-container {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .cart-item-row {
      display: flex;
      gap: 1rem;
      align-items: center;
      background: #FAF8F5;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--cream-border);
    }

    .cart-item-img {
      width: 64px;
      height: 64px;
      border-radius: 10px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .cart-item-details {
      flex: 1;
    }

    .cart-item-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-dark);
      line-height: 1.2;
    }

    .cart-item-price {
      font-weight: 800;
      color: var(--text-dark);
      font-size: 0.9rem;
      margin-top: 0.25rem;
    }

    .cart-qty-ctrl {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: var(--radius-pill);
      padding: 0.2rem 0.5rem;
    }

    .qty-btn {
      background: transparent;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      color: var(--text-dark);
    }

    .qty-btn:hover {
      color: var(--primary-dark);
    }

    .cart-empty-state {
      text-align: center;
      padding: 3rem 1.5rem;
      color: var(--text-muted);
    }

    .cart-empty-icon {
      font-size: 3.5rem;
      margin-bottom: 1rem;
      opacity: 0.6;
    }

    .cart-drawer-footer {
      padding: 1.5rem;
      border-top: 1px solid var(--cream-border);
      background: #FAF8F5;
    }

    .cart-summary-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .cart-total-line {
      display: flex;
      justify-content: space-between;
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--text-dark);
      padding-top: 0.75rem;
      border-top: 1px dashed var(--cream-border);
      margin-bottom: 1.25rem;
    }

    /* ==========================================================================
       10. DETAILS MODAL
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(8px);
      z-index: 2500;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s ease;
      padding: 1.5rem;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      background: #FFFFFF;
      border-radius: 24px;
      max-width: 580px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      position: relative;
      transform: translateY(20px) scale(0.96);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-overlay.active .modal-box {
      transform: translateY(0) scale(1);
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.5);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      z-index: 10;
      cursor: pointer;
    }

    .modal-image {
      width: 100%;
      height: 240px;
      object-fit: cover;
    }

    .modal-body {
      padding: 1.75rem;
    }

    .toast-msg {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #141210;
      color: #FFFFFF;
      padding: 0.85rem 1.4rem;
      border-radius: var(--radius-pill);
      box-shadow: 0 10px 25px rgba(0,0,0,0.25);
      border: 1px solid var(--primary);
      z-index: 3000;
      font-weight: 700;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast-msg.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive adjustments */
    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-desc {
        margin: 0 auto 2rem;
      }
      .hero-cta-wrap {
        justify-content: center;
      }
      .hero-features {
        justify-content: center;
      }
      .craving-grid {
        grid-template-columns: repeat(4, 1fr);
      }
      .products-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .promo-banners-grid {
        grid-template-columns: 1fr;
      }
      .trust-pillars-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .trust-pillar-item:not(:last-child) {
        border-right: none;
        border-bottom: 1px solid var(--cream-border);
      }
      .bottom-cta-overlay {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 3rem 2rem;
      }
      .bottom-cta-desc {
        margin: 0 auto 2rem;
      }
      .bottom-cta-visual {
        justify-content: center;
      }
    }

    @media (max-width: 640px) {
      .hero-title {
        font-size: 3rem;
      }
      .hero-title .script-love {
        font-size: 4rem;
      }
      .craving-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .products-grid {
        grid-template-columns: 1fr;
      }
      .trust-pillars-grid {
        grid-template-columns: 1fr;
      }
      .nav-links {
        display: none;
      }
      .footer-guarantees {
        flex-direction: column;
        align-items: flex-start;
      }
      .bottom-cta-headline {
        font-size: 2.75rem;
      }
      .bottom-cta-headline .script-crave {
        font-size: 3.5rem;
      }
    }
  </style>
</head>
<body>

  <!-- ==========================================================================
       1. HEADER / NAVBAR
       ========================================================================== -->
  <header>
    <div class="container nav-inner">
      <!-- Brand Logo -->
      <a href="#hero" class="brand-logo">
        <div class="brand-logo-icon">
          <!-- Chef Hat SVG Icon -->
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/>
            <line x1="6" y1="17" x2="18" y2="17"/>
          </svg>
        </div>
        <div class="brand-logo-text">
          <div class="brand-logo-name">Tasty <span>Bites</span></div>
          <div class="brand-logo-sub">GOOD FOOD • HAPPY MOOD</div>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav>
        <ul class="nav-links">
          <li><a href="#hero" class="active">Home</a></li>
          <li><a href="#menu">Menu</a></li>
          <li><a href="#specials">About</a></li>
          <li><a href="#promos">Gallery</a></li>
          <li><a href="#order-now">Contact</a></li>
        </ul>
      </nav>

      <!-- Nav Actions: Search, Cart, Order Button -->
      <div class="nav-actions">
        <!-- Search Button -->
        <button class="icon-btn" id="searchTriggerBtn" title="Buscar platillos" aria-label="Buscar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Cart Button -->
        <button class="icon-btn" id="cartTriggerBtn" title="Ver carrito" aria-label="Carrito de compras">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-badge" id="cartBadgeCount">0</span>
        </button>

        <!-- GPS Tracking Button -->
        <button class="icon-btn" id="gpsNavTriggerBtn" title="Rastreo Satelital GPS en Vivo" aria-label="Rastrear Pedido GPS" style="position: relative; color: #38bdf8;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
          <span style="position: absolute; top: -3px; right: -3px; width: 8px; height: 8px; background: #0284c7; border-radius: 50%; box-shadow: 0 0 8px #38bdf8;"></span>
        </button>

        <!-- Order Now CTA -->
        <a href="#menu" class="btn-gold" id="headerOrderBtn">
          <span>Order Now</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- ==========================================================================
       2. HERO SECTION ("Food Made with Love ♡")
       ========================================================================== -->
  <section class="hero-section" id="hero">
    <div class="container hero-grid">
      <!-- Left Content Column -->
      <div>
        <div class="hero-tag">
          FRESH <span>•</span> TASTY <span>•</span> DELICIOUS
        </div>
        <h1 class="hero-title">
          Food <br />
          Made with <span class="script-love">Love<span class="doodle-heart">♡</span></span>
        </h1>
        <p class="hero-desc">
          From cheesy pizzas to juicy burgers, we serve the best food made with fresh ingredients and a whole lot of love.
        </p>

        <div class="hero-cta-wrap">
          <a href="#menu" class="btn-gold" style="padding: 0.85rem 1.85rem; font-size: 1rem;">
            <span>Order Now</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/app" class="btn-outline" style="color: #FFFFFF; border-color: rgba(255,255,255,0.3); padding: 0.85rem 1.4rem;">
            <span>📱 PWA App</span>
          </a>
        </div>

        <!-- 3 Feature Badges -->
        <div class="hero-features">
          <div class="hero-feature-item">
            <div class="hero-feature-icon">
              <!-- Leaf Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <div class="hero-feature-text">Fresh<br />Ingredients</div>
          </div>

          <div class="hero-feature-item">
            <div class="hero-feature-icon">
              <!-- Fast Delivery Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="hero-feature-text">Fast<br />Delivery</div>
          </div>

          <div class="hero-feature-item">
            <div class="hero-feature-icon">
              <!-- Shield Check Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="hero-feature-text">Hygienic<br />& Safe</div>
          </div>
        </div>
      </div>

      <!-- Right Visual Column (Hero Burger on Wood Board with Fries and Dip) -->
      <div class="hero-visual">
        <div class="hero-image-container">
          <img 
            class="hero-main-img" 
            src="https://images.unsplash.com/photo-1586190848861-99aa4a171e90?w=1000&auto=format&fit=crop&q=85" 
            alt="Signature Gourmet Burger with Golden Fries and Dip" 
          />
          <!-- Doodle Annotation: "Best Burger in Town" -->
          <div class="hero-doodle">
            <span class="sparks">\ | /</span>
            <span>Best Burger<br />in Town</span>
            <span class="arrow">⤷</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       3. CATEGORY CAROUSEL ("Something for Every Craving")
       ========================================================================== -->
  <section class="craving-section" id="menu">
    <div class="container">
      <div class="section-header-row">
        <div>
          <div class="section-label">EXPLORE OUR MENU</div>
          <h2 class="section-title">Something for Every Craving</h2>
        </div>
        <a href="#specials" class="view-all-link">
          <span>View Full Menu</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- 7 Circular Categories Replicating the Design -->
      <div class="craving-grid">
        {cravingCategories.map((cat, index) => (
          <button class={`craving-card ${index === 0 ? 'active' : ''}`} data-category={cat.id}>
            <div class="craving-img-circle">
              <img src={cat.image} alt={cat.name} loading="lazy" />
            </div>
            <span class="craving-name">{cat.name}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       4. OUR SPECIALS / "Popular Menu"
       ========================================================================== -->
  <section class="specials-section" id="specials">
    <div class="container">
      <div class="section-header-row">
        <div>
          <div class="specials-label-row">
            <span class="specials-label">OUR SPECIALS</span>
            <span class="specials-dash"></span>
          </div>
          <h2 class="section-title">Popular Menu</h2>
          <p class="specials-subtitle">
            Explore our most loved dishes, crafted for your taste and happiness.
          </p>
        </div>
        <a href="#author-burgers" class="btn-outline">
          <span>View Full Menu</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- 4 Popular Menu Cards from the Design (Margherita Pizza, Classic Burger, French Fries, Chocolate Shake) -->
      <div class="products-grid">
        {popularDishes.map((dish) => (
          <article class="product-card" data-category={dish.category}>
            <div class="product-img-wrap">
              {dish.badge && (
                <span class={`card-badge-pill ${dish.badgeType === 'gold' ? 'card-badge-gold' : ''}`}>
                  {dish.badge}
                </span>
              )}
              <img src={dish.image} alt={dish.name} loading="lazy" />
            </div>

            <div class="card-content">
              <h3 class="product-title">{dish.name}</h3>
              <p class="product-desc">{dish.description}</p>

              <div class="product-footer">
                <div class="product-price-row">
                  <div class="product-price">
                    {dish.displayPrice}
                    {dish.altPrice && <small>({dish.altPrice})</small>}
                  </div>
                  <div class="product-rating">★ {dish.rating}</div>
                </div>

                <button 
                  class="btn-add-cart add-to-cart-btn"
                  data-id={dish.id}
                  data-name={dish.name}
                  data-price={dish.price}
                  data-img={dish.image}
                >
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span>Add to Cart</span>
                </button>

